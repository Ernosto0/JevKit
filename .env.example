# JevKit configuration. Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Jev: the primary decision provider
# ---------------------------------------------------------------------------
# Get a key from https://console.typesafe.ai/settings/keys
# Keys issued by jevai.org are for a DIFFERENT service and will 401 here.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# ---------------------------------------------------------------------------
# Optional reference / fallback provider
# ---------------------------------------------------------------------------
# Leave FALLBACK_PROVIDER empty to disable fallback entirely. A fallback is not
# assumed to be more accurate; its output is validated like any other.
#
# The built-in "reference" provider calls an OpenAI-compatible Chat
# Completions API (JSON-schema structured outputs). Set FALLBACK_PROVIDER=reference
# and supply an OpenAI API key to use it; JEVKIT_FALLBACK_BASE_URL can point at
# any other OpenAI-compatible endpoint instead (defaults to api.openai.com/v1),
# and JEVKIT_FALLBACK_MODEL defaults to gpt-4o-mini.
JEVKIT_FALLBACK_PROVIDER=
JEVKIT_FALLBACK_API_KEY=
JEVKIT_FALLBACK_BASE_URL=
JEVKIT_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# Execution defaults (a per-call policy may override these)
# ---------------------------------------------------------------------------
JEVKIT_TIMEOUT_SECONDS=10
JEVKIT_MAX_RETRIES=1
JEVKIT_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------
JEVKIT_TRACE_ENABLED=true
# Off by default: inputs may contain personal or sensitive data. Turn this on
# only when you have decided what you are storing and for how long.
JEVKIT_TRACE_STORE_INPUTS=false
JEVKIT_TRACE_DIR=.jevkit/traces

# ---------------------------------------------------------------------------
# API service (apps/api) -- not needed for SDK-only use
# ---------------------------------------------------------------------------
JEVKIT_API_ENVIRONMENT=development
JEVKIT_API_DEBUG=false

# Comma-separated client API keys. Leaving this empty disables authentication,
# which is acceptable for local development ONLY.
JEVKIT_API_API_KEYS=

JEVKIT_DATABASE_URL=postgresql+asyncpg://jevkit:jevkit@localhost:5432/jevkit
JEVKIT_API_CORS_ORIGINS=http://localhost:5173
JEVKIT_API_MAX_REQUEST_BYTES=256000
JEVKIT_API_MAX_CONCURRENT_DECISIONS=16

# ---------------------------------------------------------------------------
# Local Postgres (docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=jevkit
POSTGRES_PASSWORD=jevkit
POSTGRES_DB=jevkit
POSTGRES_PORT=5432
